generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  plan              String   @default("free") // free, pro, clinic
  isActive          Boolean  @default(true)   // Controle de ativação/inativação pelo Admin
  aiAgentsEnabled   Boolean  @default(false)  // Liberado pelo Admin por consultório
  logoUrl           String?  // Logomarca / imagem do consultório (Data URL otimizada ou URL)
  headline          String?  // Ex: "Psicoterapia & Acolhimento Humanizado"
  bio               String?  // Descrição do terapeuta para a página pública
  whatsapp          String?  // WhatsApp para contato direto
  instagram         String?  // @doinstagram
  consultationPrice Float    @default(220.0)
  monthlyIncomeGoal Float    @default(10000.0)
  weeklyMaxHours    Int      @default(20)
  pixKey            String?  // Chave Pix própria do terapeuta
  pixType           String?  @default("email") // cpf, cnpj, email, phone, random
  pixName           String?  // Nome completo do titular do Pix
  professionalReg   String?  // Ex: CRP 06/123456 ou CRTH-BR 1234
  meetingUrlDefault String?  // Link de sala virtual padrão (Google Meet / Zoom)
  address           String?  // Endereço físico do consultório (opcional)

  // Configurações do WhatsApp Exclusivo do Consultório (Evolution API)
  whatsappInstanceName String? // Ex: tenant_edulara
  whatsappStatus       String  @default("disconnected") // disconnected, connecting, open, close
  whatsappQrCode       String? // Base64 do QR code para leitura na tela
  whatsappAutoReminder Boolean @default(true) // Enviar lembretes automáticos
  whatsappReminderHours Int    @default(24) // Horas de antecedência para o lembrete principal
  whatsappSend2hReminder Boolean @default(true) // Enviar segundo lembrete 2h antes com link/endereço
  whatsappReminderText String? // Mensagem personalizada do lembrete principal
  whatsappReminder2hText String? // Mensagem do lembrete de 2h antes

  packages          Package[]
  emotions          Emotion[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Configurações da Central de Agentes B.E.M. & n8n
  aiApiKey              String?
  n8nWebhookUrl         String?
  aiDefaultDeliveryMode String  @default("review") // 'review' (revisão humana) | 'auto' (disparo direto)
  aiCorePhilosophy      String? // Diretrizes filosóficas mestras do método B.E.M.

  users        User[]
  patients     Patient[]
  appointments Appointment[]
  records      ClinicalRecord[]
  finances     FinancialTransaction[]
  leads        Lead[]
  availabilityRules  AvailabilityRule[]
  blockedDates       BlockedDate[]
  blockedSlots       BlockedSlot[]
  anamnesisQuestions AnamnesisQuestion[]
  aiAgentConfigs     AiAgentConfig[]
  knowledgeSources   KnowledgeSource[]
  knowledgeChunks    KnowledgeChunk[]
  structuredMemories StructuredMemory[]
  patientPrograms    PatientProgram[]
  aiDispatches       AiMessageDispatch[]
  agentThreads       AgentThread[]
}

model User {
  id                    String    @id @default(cuid())
  tenantId              String
  name                  String
  email                 String    @unique
  phone                 String?   // Celular para envio do código de validação
  passwordHash          String
  role                  String    @default("therapist") // super_admin, therapist, secretary
  isVerified            Boolean   @default(true)
  verificationCode      String?
  verificationExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Patient {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  phoneEnc     String    // Criptografado AES-256-GCM
  emailEnc     String?   // Criptografado AES-256-GCM
  cpfEnc       String?   // Criptografado AES-256-GCM
  anamnesisEnc String?   // Respostas da Anamnese criptografadas AES-256-GCM
  birthDate    DateTime?
  status       String    @default("active") // active, inactive, archived
  notes        String?   // Observações gerais não-clínicas
  modalityPreference String @default("online") // 'online' | 'in_person' (definido pelo terapeuta)
  sessionTypePreference String @default("regular") // 'regular', 'experimental', 'descoberta', 'package'
  packageId    String?   // Vinculado a um pacote ativo
  packageTotalSessions Int? @default(0)
  packageUsedSessions  Int? @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  records      ClinicalRecord[]
  finances     FinancialTransaction[]
  memories     StructuredMemory[]
  programs     PatientProgram[]
  aiDispatches AiMessageDispatch[]
  agentThreads AgentThread[]

  @@index([tenantId])
}

model Appointment {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  scheduledAt DateTime
  durationMin Int      @default(50)
  status      String   @default("scheduled") // scheduled, confirmed, completed, cancelled, no_show
  modality    String   @default("online")    // online, in_person
  sessionType String   @default("regular")   // regular, experimental, descoberta, package
  packageId   String?
  meetingUrl  String?
  price       Float    @default(0.0)
  notes       String?
  reminderSent Boolean @default(false) // Flag para não reenviar lembrete 24h
  reminder2hSent Boolean @default(false) // Flag para não reenviar lembrete 2h
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  record      ClinicalRecord?
  transaction FinancialTransaction?

  @@index([tenantId, scheduledAt])
  @@index([patientId])
}

model ClinicalRecord {
  id            String   @id @default(cuid())
  tenantId      String
  patientId     String
  appointmentId String?  @unique
  sessionDate   DateTime @default(now())
  rawDraftEnc   String?  // Rascunho criptografado AES-256-GCM
  soapEnc       String   // JSON {subjective, objective, assessment, plan} criptografado
  aiAssisted    Boolean  @default(false)
  isLocked      Boolean  @default(false) // Travamento após conclusão (exigência ético-clínica)
  emocoesTrabalhadas String? // JSON array com as emoções trabalhadas (ex: ["Insegurança", "Raiva"])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, patientId])
}

model FinancialTransaction {
  id            String    @id @default(cuid())
  tenantId      String
  patientId     String?
  appointmentId String?   @unique
  type          String    // income, expense
  category      String    // consultation, package, rent, supervision, software
  amount        Float     @default(0.0)
  dueDate       DateTime
  paidAt        DateTime?
  status        String    @default("pending") // pending, paid, cancelled
  paymentMethod String?   // pix, card, cash, transfer
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, dueDate])
  @@index([tenantId, status])
}

model Lead {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  phoneEnc      String   // Criptografado AES-256-GCM
  emailEnc      String?  // Criptografado AES-256-GCM
  demand        String?  // Queixa ou motivo da busca
  preferredTime String?  // Manhã, Tarde, Noite
  modality      String   @default("online") // online, in_person
  stage         String   @default("new_lead") // new_lead, contacted, scheduled, converted, lost
  source        String   @default("pagina_publica") // pagina_publica, instagram, indicacao
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stage])
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  tenantId  String
  dayOfWeek Int      // 0 = Domingo, 1 = Segunda, 2 = Terça, 3 = Quarta, 4 = Quinta, 5 = Sexta, 6 = Sábado
  enabled   Boolean  @default(true)
  hours     String   // Horários separados por vírgula: "08:00,09:00,10:00,11:00,14:00,15:00,16:00,17:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model BlockedDate {
  id        String   @id @default(cuid())
  tenantId  String
  date      String   // Formato YYYY-MM-DD (ex: "2026-12-25")
  reason    String?  // Ex: "Feriado de Natal", "Folga", "Recesso de fim de ano"
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  tenantId  String
  date      String   // Formato YYYY-MM-DD
  time      String   // Formato HH:mm (ex: "14:00")
  reason    String?  // Ex: "Indisponibilizado manualmente"
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, time])
  @@index([tenantId, date])
}

model Package {
  id              String   @id @default(cuid())
  tenantId        String
  title           String   // Ex: Pacote 5 Sessões Bioenergética
  description     String?
  totalSessions   Int      @default(5)
  totalPrice      Float    @default(800.0)
  pricePerSession Float    @default(160.0) // Rateio automático
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Emotion {
  id          String   @id @default(cuid())
  tenantId    String?  // Opcional: nulo para globais do sistema, ou preenchido para customizadas pelo terapeuta
  code        String?  // Ex: "A1", "A2", "B1"
  title       String   // Ex: "Insegurança", "Segurança"
  description String   // Texto explicativo e terapêutico completo da emoção
  phrases     String?  // Frases de ancoragem / reflexão
  type        String   // "Negativa" | "Positiva"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([title])
}

model Frequency {
  id          String   @id @default(cuid())
  number      String   // Número identificador da frequência (ex: "1", "2", ... "9", etc.)
  title       String   // Título da expressão vibracional
  description String   // Descrição profunda da expressão vibracional na realidade / protocolo B.E.M.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([number])
}

model AnamnesisQuestion {
  id        String   @id @default(cuid())
  tenantId  String
  question  String   // Pergunta exibida na ficha de anamnese do prontuário
  hint      String?  // Orientação opcional para o terapeuta
  fieldType String   @default("textarea") // 'textarea' | 'text' | 'yes_no'
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sortOrder])
}

model AiAgentConfig {
  id           String   @id @default(cuid())
  tenantId     String
  slug         String   // 'marketing' | 'pos_sessao' | 'expansao' | 'gestao'
  name         String
  description  String?
  systemPrompt String   // Instruções customizáveis deste agente
  deliveryMode String   @default("review") // 'review' (revisão humana) | 'auto' (disparo direto)
  autoMemory   Boolean  @default(true)
  webhookUrl   String?  // Webhook dedicado no n8n (opcional)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model KnowledgeSource {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  sourceType  String   @default("text") // 'directive' | 'seminar_note' | 'bibliography' | 'pdf' | 'text' | 'url'
  domainScope String   @default("all")  // 'all' | 'marketing' | 'pos_sessao' | 'expansao' | 'gestao'
  authorOrRef String?  // Autor, livro, seminário ou evento
  sourceUrl   String?
  rawContent  String
  tags        String?
  isPinned    Boolean  @default(false) // Sempre presente no contexto como regra fundamental
  chunkCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]

  @@index([tenantId, domainScope])
}

model KnowledgeChunk {
  id            String   @id @default(cuid())
  tenantId      String
  sourceId      String
  chunkIndex    Int
  content       String
  embeddingJson String?  // Array JSON de floats gerado pelo Gemini Embedding
  createdAt     DateTime @default(now())

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source        KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sourceId])
}

model StructuredMemory {
  id            String   @id @default(cuid())
  tenantId      String
  scope         String   // 'marketing' | 'gestao' | 'expansao' | 'atendimento'
  patientId     String?  // Preenchido quando scope = 'atendimento'
  category      String   @default("geral")
  title         String
  contentEnc    String   // Criptografado AES-256-GCM (sigilo LGPD para memórias clínicas)
  importance    Int      @default(3) // 1 a 5
  isPinned      Boolean  @default(false)
  source        String   @default("manual") // 'manual' | 'agent_auto' | 'prontuario' | 'n8n'
  embeddingJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope])
  @@index([tenantId, patientId])
}

model PatientProgram {
  id                String   @id @default(cuid())
  tenantId          String
  patientId         String?  // Null = Modelo/Template reutilizável; Preenchido = Programa ativo do paciente
  title             String
  goal              String?
  durationDays      Int      @default(7)
  stepsJson         String   // JSON array das etapas/dias do programa
  deliveryMode      String   @default("review") // 'review' | 'auto'
  status            String   @default("active") // 'template' | 'active' | 'paused' | 'completed'
  currentDay        Int      @default(1)
  preferredSendHour String   @default("08:00")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient?            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dispatches        AiMessageDispatch[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
}

model AiMessageDispatch {
  id            String    @id @default(cuid())
  tenantId      String
  agentSlug     String    // 'pos_sessao' | 'expansao' | 'gestao' | 'marketing'
  patientId     String?
  appointmentId String?
  programId     String?
  channel       String    @default("whatsapp") // 'whatsapp' | 'n8n_webhook'
  deliveryMode  String    @default("review")   // 'review' | 'auto'
  title         String
  messageText   String
  status        String    @default("pending_review") // 'pending_review' | 'sent' | 'failed' | 'rejected'
  errorMsg      String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull)
  program       PatientProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, patientId])
}

model AgentThread {
  id        String         @id @default(cuid())
  tenantId  String
  agentSlug String
  patientId String?
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient   Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  messages  AgentMessage[]

  @@index([tenantId, agentSlug])
}

model AgentMessage {
  id                    String      @id @default(cuid())
  threadId              String
  role                  String      // 'user' | 'assistant'
  content               String
  memoriesExtractedJson String?
  sourcesUsedJson       String?
  createdAt             DateTime    @default(now())

  thread                AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}



